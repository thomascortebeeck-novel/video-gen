# Non-secret runtime parameters (deployed with functions).
#
# VIDEO_ENGINE: auto | seedance25 | ark25 | fal25 | seedance1
#   auto = best available: Higgsfield Seedance 2.5 (when SEEDANCE25_PATH is
#   set) → BytePlus ModelArk 2.5 (ARK_API_KEY secret — official & cheapest) →
#   fal.ai 2.5 (FAL_KEY secret) → Higgsfield Seedance v1 keyframe pipeline →
#   mock.
VIDEO_ENGINE=auto

# Set this to the Seedance 2.5 endpoint path on platform.higgsfield.ai the
# moment it ships (e.g. bytedance/seedance/v2.5) — the 2.5 adapter activates.
SEEDANCE25_PATH=

# fal.ai base model id for Seedance 2.5 (endpoint variants are appended).
FAL_SEEDANCE25_BASE=bytedance/seedance-2.5

# BytePlus ModelArk API base URL (ap-southeast is the verified Seedance 2.5 region).
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
